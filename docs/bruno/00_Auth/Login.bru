meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{userEmail}}",
    "password": "{{userPassword}}"
  }
}

script:post-response {
  if (res.status === 200 && res.body.data) {
    bru.setEnvVar("token", res.body.data.token);
  }
}

docs {
  Autentica e grava o JWT em `token`. `mustChangePassword=true` indica primeiro acesso pendente (o bloqueio de navegação é feito pelo frontend).
}
