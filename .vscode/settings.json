  "files.associations": {
    "*.sql": "postgres",
    "*.tex": "latex",
    "*.bib": "bibtex",
    "*.sty": "latex",
    "*.cls": "latex",
    "Dockerfile*": "dockerfile",
    "docker-compose*.yml": "dockercompose",
    "*.env*": "properties"
  },

  // --- FILTROS DO EXPLORADOR (OCULTA RUÍDOS SEM APAGAR) ---
