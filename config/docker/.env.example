# ====================================================================
# SIGEA: Sistema Inteligente de Gestão de Eventos Adversos
# Arquivo Modelo de Variáveis de Ambiente (.env.example)
# ====================================================================

# ── Banco de Dados (PostgreSQL 16) ──────────────────────────────────
POSTGRES_USER=sigea_admin
POSTGRES_PASSWORD=sigea_dev_password
POSTGRES_DB=sigea
POSTGRES_PORT=5432

# URL JDBC para Spring Boot (Local ou Neon.tech)
# Local Docker: jdbc:postgresql://localhost:5432/sigea
# Neon Cloud:   jdbc:postgresql://ep-xyz.sa-east-1.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/sigea
SPRING_DATASOURCE_USERNAME=sigea_admin
SPRING_DATASOURCE_PASSWORD=sigea_dev_password

# ── Servidor Backend (Spring Boot 3.3) ──────────────────────────────
PORT=8080
SERVER_PORT=8080

# ── Segurança & JWT ─────────────────────────────────────────────────
# Chave secreta HMAC-SHA de 256 bits (exemplo de homologação)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_HOURS=24

# ── CORS & Integração Frontend ──────────────────────────────────────
# Em produção/homologação: https://sigea.vercel.app ou *
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://sigea.vercel.app
