# ───────────────────────────────────────────────────────────
# .gitignore — SIGEA-GTT (Spring Boot + Angular + LaTeX)
# ───────────────────────────────────────────────────────────

# Antigravity IDE workspace & transient cache
.antigravity/*.log
.antigravity/cache/
.antigravity/.tempmediaStorage/
.agents/cache/

# ── Java / Maven ────────────────────────────────────────────
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*

# ── Node / Angular / npm ────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.angular/
frontend/.angular/cache/
frontend/coverage/
frontend/.env
frontend/.env.*
*.tsbuildinfo

# ── LaTeX build artifacts ───────────────────────────────────
*.aux
*.bbl
*.blg
*.lof
*.log
*.lot
*.out
*.toc
*.brf
*.synctex.gz
*.fls
*.fdb_latexmk
*.idx
*.ilg
*.ind
*.nav
*.snm
*.vrb
*.loa
*.loc
*.loq

# ── PostgreSQL / Docker ─────────────────────────────────────
database/dados/
*.env
.env

# ── IDE / OS ─────────────────────────────────────────────────
.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.swp
*.swo

# ── Testes / relatórios ──────────────────────────────────────
frontend/test-results/
frontend/playwright-report/
backend/target/surefire-reports/
backend/target/site/
